# Runtime data — contains real vendor documents and extracted PII (GSTIN, PAN, bank details)
backend/app/uploads/
backend/app/outputs/
backend/app/logs/
backend/logs/

# Local SQLite databases (auth flow default DATABASE_URL). Test/Prod use Postgres.
*.db
backend/app.db
backend/_alembic_placeholder.db

# The CLI entry points (pipeline.py, dump_ocr.py) default --out to a path relative
# to the working directory, so a run from backend/ lands here rather than under
# app/. Same PII, same rule. Unanchored so it also catches a run from the repo root.
outputs/
uploads/

# Ground truth for real vendors transcribes the same PII as the source documents
# (GSTIN, PAN, bank account numbers). Git history is permanent, so only the
# synthetic example is tracked; real vendor files stay local.
backend/app/eval/ground_truth/*.yaml
!backend/app/eval/ground_truth/example_synthetic.yaml

# Logs
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
.venv-paddle/
.pytest_cache/

# Editor / IDE
.vscode/
.idea/

# Env / secrets -- real env files are per-host and never committed; the
# .env*.example templates are.
.env
.env.*
!.env.example
!.env.*.example

# Node / React
node_modules/
dist/
.vite/

# Local assistant context notes, not part of this project
CLAUDE.md
