# PRODUCTION environment. Copy to .env.production on the Production host.
# Start the backend with:  ENV_FILE=.env.production uvicorn main:app
#
# Changes reach here ONLY after being validated in Test and approved via a
# Pull / Change Request -- see docs/PROMOTION.md. config.py refuses to start in
# production if DATABASE_URL is still SQLite, SECRET_KEY is too short, or
# CORS_ALLOW_ORIGINS is empty.

ENV=production

APP_TITLE=Vendor Form Extractor
DEBUG=false

# --- Security ---
# A DISTINCT secret from Test. Rotating it logs every user out.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database ---
# The Production Postgres instance. Isolated from Test.
#   postgresql+psycopg://bc_portal_prod:PASSWORD@prod-db-host:5432/bc_portal_prod
DATABASE_URL=

# --- CORS ---
# Exactly the Production portal's origin(s), comma-separated. No wildcards.
CORS_ALLOW_ORIGINS=https://bc-portal.netsmartz.example

# --- Business Central push ---
# Enabled in Production once the BC service account is provisioned (step 6).
BC_ENABLED=false
BC_ODATA_BASE=http://ntz-srv-bcdb:2248/BC220/ODataV4
BC_COMPANY=Netsmartz Infotech (India) Pri
BC_GEN_BUS_POSTING_GROUP=
BC_VAT_BUS_POSTING_GROUP=
BC_VENDOR_POSTING_GROUP=

# --- Optional ---
# VENDOR_LOG_LEVEL=INFO
