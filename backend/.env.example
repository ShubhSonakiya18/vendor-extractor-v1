# LOCAL development. Copy to .env and fill in.
# See app/config/config.py for every setting; docs/PROMOTION.md for how the
# Test and Production environments differ.

ENV=local

APP_TITLE=Vendor Form Extractor
DEBUG=true

# --- Security (auth flow) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database ---
# SQLite is fine for local dev. Test / Production use Postgres.
DATABASE_URL=sqlite:///./app.db

# --- CORS ---
# Leave blank locally (any localhost origin is allowed automatically).
CORS_ALLOW_ORIGINS=

# --- Business Central (manual vendor/customer push) ---
# When true, the portal exposes GET /business-central/{vendors,customers}/{id}/payload
# and the "Get BC payload" button on the vendor/customer detail page. The
# actual POST to BC is done by an operator on a VPN machine (scripts/push_to_bc.ps1).
BC_ENABLED=false
BC_ODATA_BASE=http://ntz-srv-bcdb:2248/BC220/ODataV4
BC_COMPANY=Netsmartz Infotech (India) Pri
# Sent on the VendorCard/CustomerCard payload only when set (BC may require them on insert):
BC_GEN_BUS_POSTING_GROUP=
BC_VAT_BUS_POSTING_GROUP=
BC_VENDOR_POSTING_GROUP=
BC_CUSTOMER_POSTING_GROUP=

# --- Optional overrides (defaults in config.py) ---
# VENDOR_LOG_LEVEL=INFO
# VENDOR_RAPID_RENDER_DPI=100
