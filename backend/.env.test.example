# TEST environment. Copy to .env.test on the Test host and fill in.
# Start the backend with:  ENV_FILE=.env.test uvicorn main:app
#
# The Test portal is where every new feature is deployed and validated first.
# It must NOT touch Production data or Production Business Central -- see
# docs/PROMOTION.md.

ENV=test

APP_TITLE=Vendor Form Extractor (Test)
DEBUG=false

# --- Security ---
# A DISTINCT secret from Production. Generate its own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database ---
# The Test Postgres instance. Never the Production database.
#   postgresql+psycopg://bc_portal_test:PASSWORD@test-db-host:5432/bc_portal_test
DATABASE_URL=

# --- CORS ---
# Exactly the Test portal's origin(s), comma-separated. No wildcards.
CORS_ALLOW_ORIGINS=https://bc-portal-test.netsmartz.example

# --- Business Central push ---
# Off in Test unless a BC sandbox company is configured. When enabled, it must
# point at a BC test company, never Production BC.
BC_ENABLED=false
BC_ODATA_BASE=http://ntz-srv-bcdb:2248/BC220/ODataV4
BC_COMPANY=Netsmartz Infotech (India) Pri
BC_GEN_BUS_POSTING_GROUP=
BC_VAT_BUS_POSTING_GROUP=
BC_VENDOR_POSTING_GROUP=

# --- Optional ---
# VENDOR_LOG_LEVEL=INFO
